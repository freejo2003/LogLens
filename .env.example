# Local Compose defaults only. Replace every placeholder before deployment.
DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=local-development-only-replace-before-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false

POSTGRES_DB=loglens
POSTGRES_USER=loglens
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_PORT=5432
REDIS_PASSWORD=local-only-change-me-too

LOGLENS_HTTP_PORT=8080
LOGLENS_MAX_UPLOAD_SIZE=26214400
LOGLENS_MAX_UPLOAD_BATCH_SIZE=52428800
LOGLENS_MAX_UPLOAD_COUNT=10
LOGLENS_MAX_DOCX_UNCOMPRESSED_SIZE=104857600
LOGLENS_MAX_EXTRACTED_CHARACTERS=5242880
LOGLENS_MAX_TEXT_SEGMENTS=100000
LOGLENS_MAX_PDF_PAGES=1000
LOGLENS_DOC_CONVERSION_TIMEOUT=60
LOGLENS_MAX_SEARCH_MATCHES=100000
CELERY_WORKER_CONCURRENCY=2
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=330

SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_SSL=false
SMTP_TIMEOUT=10
LOG_LEVEL=INFO
